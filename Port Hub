local layout = Instance.new("UIListLayout")
layout.Padding = UDim.new(0, 6)
layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
layout.Parent = frame

local padding = Instance.new("UIPadding")
padding.PaddingTop = UDim.new(0, 8)
padding.Parent = frame

local function makeToggle(label, key, order)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(0, 190, 0, 40)
    button.LayoutOrder = order
    button.Font = Enum.Font.GothamBold
    button.TextSize = 14
    button.TextColor3 = Color3.new(1, 1, 1)
    button.Parent = frame

    local function refresh()
        button.Text = label .. ": " .. (state[key] and "ON" or "OFF")
        button.BackgroundColor3 = state[key] and Color3.fromRGB(40, 160, 60) or Color3.fromRGB(120, 40, 40)
    end

    button.MouseButton1Click:Connect(function()
        state[key] = not state[key]
        refresh()
    end)
    refresh()
end

makeToggle("Auto farm coca", "AutoFarm", 1)
makeToggle("Auto attack", "AutoAttack", 2)
makeToggle("Fast attack", "FastAttack", 3)
makeToggle("Auto chest farm", "AutoChest", 4)

